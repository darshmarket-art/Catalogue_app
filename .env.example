# Copy to .env for local development. Never commit real values.

# --- Required in production (the server refuses to start without them) ---
# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Held by the Managing Director; required to create admin accounts. 16+ characters.
MASTER_PROVISIONING_KEY=

# --- Optional ---
# firestore (default in production) | file (default in development, ./data/local-db.json) | memory
# STORE=file
# Load the demo catalogue into an empty database (default: on in development, off in production)
# SEED_DEMO_CATALOGUE=true
# Port to listen on (Cloud Run sets this automatically)
# PORT=3000
