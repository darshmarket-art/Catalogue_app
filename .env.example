# Copy to .env for local development. Never commit real values.

# --- Required in production (the server refuses to start without them) ---
# Signs session tokens. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Held by the Managing Director; required to create admin accounts. 16+ characters.
MASTER_PROVISIONING_KEY=

# --- Optional ---
# firestore (default in production) | file (default in development, ./data/local-db.json) | memory
# STORE=file
# Load the demo catalogue into an empty database (default: on in development, off in production)
# SEED_DEMO_CATALOGUE=true

# --- Sign-in codes (OTP) ---
# How codes reach buyers and owners. Leave unset to auto-detect: whatsapp when the WHATSAPP_* values below are set,
# otherwise static when OTP_STATIC_CODE is set, otherwise console (development only: codes are printed to the log).
# Set explicitly to force one, e.g. OTP_PROVIDER=static to keep the fixed code while credentials are present.
# OTP_PROVIDER=whatsapp
# Fixed 6-digit code used by every sign-in while WhatsApp is not configured. Never revealed in responses in production.
# OTP_STATIC_CODE=123456
# Live delivery via the Meta WhatsApp Cloud API (all three required). Get them from Meta for Developers -> your app ->
# WhatsApp -> API Setup. Use a permanent System User token in production, not the 24-hour test token.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Name of your APPROVED "Authentication" category template with a copy-code button, and its locale.
# WHATSAPP_OTP_TEMPLATE=verification_code
# WHATSAPP_OTP_LANGUAGE=en_US
# WHATSAPP_API_VERSION=v25.0
# Optional utility templates for owner alerts: order placed/cancelled, the daily "catalogue full" nudge, trial notices.
# WHATSAPP_ORDER_TEMPLATE=
# WHATSAPP_STORE_FULL_TEMPLATE=
# WHATSAPP_TRIAL_TEMPLATE=
# Codes allowed per store per day (default 500).
# OTP_DAILY_CAP=500
# Check credentials and send yourself a test code: npx tsx --env-file=.env scripts/whatsapp-check.ts --send 9198XXXXXXXX

# Cloud Storage bucket for photos and an optional merchant.json (production). Unset in development:
# photos then go to ./data/uploads
# STORAGE_BUCKET=my-project-bhakti-media
# Port to listen on (Cloud Run sets this automatically)
# PORT=3000

# Native (Capacitor) builds only: absolute API origin baked in at build time. Leave unset for web.
# VITE_API_BASE=https://your-service.run.app

# Native (Capacitor) builds only: absolute API origin baked in at build time. Leave unset for web.
# VITE_API_BASE=https://your-service.run.app
